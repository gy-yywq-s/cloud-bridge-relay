{
  "name": "crew-relay",
  "version": "1.0.0",
  "description": "Team up multiple AI coding sessions (Claude Code + Codex) with shared mailboxes, a task board, guided setup, and an owner mailbox. Self-hostable MCP server with OAuth 2.1.",
  "type": "module",
  "bin": {
    "crew-relay": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "arctic": "^3.7.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.1",
    "resend": "^6.18.1",
    "smol-toml": "^1.4.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
